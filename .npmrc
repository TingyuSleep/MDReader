# ---------------------------------------------------------------------------
# 本机（Windows）适配：pnpm 默认的 isolated 链接器依赖符号链接，
# 在启用供应链安全策略的环境下会被静默拦截（不报错但不建任何链接）。
# 改用 hoisted 模式（真实目录，不用软链），行为等价于 npm 的扁平安装。
# ---------------------------------------------------------------------------
node-linker=hoisted

# 统一走国内镜像，保证离线打包前依赖可稳定获取
registry=https://registry.npmmirror.com/
